{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MasonRhodesDev/open-comfort-engine/spec/schema/event.schema.json",
  "title": "EngineEvent (spec \u00a74)",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "type",
        "now",
        "user",
        "dir"
      ],
      "properties": {
        "type": {
          "const": "vote"
        },
        "now": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt ]\\d{2}:\\d{2}(:\\d{2}(\\.\\d+)?)?([Zz]|[+-]\\d{2}:\\d{2})$"
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "dir": {
          "enum": [
            "hot",
            "cold"
          ]
        },
        "src": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "now",
        "tin"
      ],
      "properties": {
        "type": {
          "const": "reading"
        },
        "now": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt ]\\d{2}:\\d{2}(:\\d{2}(\\.\\d+)?)?([Zz]|[+-]\\d{2}:\\d{2})$"
        },
        "tin": {
          "type": "number"
        },
        "rh": {
          "type": "number"
        },
        "equip": {
          "enum": [
            "heat",
            "cool",
            "fan",
            "idle",
            "off"
          ]
        },
        "applied": {
          "type": "object",
          "properties": {
            "heat": {
              "type": "number"
            },
            "cool": {
              "type": "number"
            },
            "mode": {
              "enum": [
                "heat",
                "cool",
                "auto",
                "off"
              ]
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "now",
        "out"
      ],
      "properties": {
        "type": {
          "const": "weather"
        },
        "now": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt ]\\d{2}:\\d{2}(:\\d{2}(\\.\\d+)?)?([Zz]|[+-]\\d{2}:\\d{2})$"
        },
        "out": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "low": {
          "type": "number"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "now",
        "applied"
      ],
      "properties": {
        "type": {
          "const": "manual"
        },
        "now": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt ]\\d{2}:\\d{2}(:\\d{2}(\\.\\d+)?)?([Zz]|[+-]\\d{2}:\\d{2})$"
        },
        "applied": {
          "type": "object",
          "properties": {
            "heat": {
              "type": "number"
            },
            "cool": {
              "type": "number"
            },
            "mode": {
              "enum": [
                "heat",
                "cool",
                "auto",
                "off"
              ]
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "now",
        "on"
      ],
      "properties": {
        "type": {
          "const": "freeze"
        },
        "now": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt ]\\d{2}:\\d{2}(:\\d{2}(\\.\\d+)?)?([Zz]|[+-]\\d{2}:\\d{2})$"
        },
        "on": {
          "type": "boolean"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "now"
      ],
      "properties": {
        "type": {
          "const": "tick"
        },
        "now": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt ]\\d{2}:\\d{2}(:\\d{2}(\\.\\d+)?)?([Zz]|[+-]\\d{2}:\\d{2})$"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "now",
        "snapshot"
      ],
      "properties": {
        "type": {
          "const": "restore"
        },
        "now": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt ]\\d{2}:\\d{2}(:\\d{2}(\\.\\d+)?)?([Zz]|[+-]\\d{2}:\\d{2})$"
        },
        "snapshot": {
          "$ref": "snapshot.schema.json"
        }
      }
    }
  ]
}
