{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MasonRhodesDev/open-comfort-engine/spec/schema/zone-config.schema.json",
  "title": "ZoneConfig (spec \u00a73)",
  "type": "object",
  "required": [
    "id",
    "capabilities",
    "seed",
    "setback"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "object",
      "required": [
        "modes",
        "minGap",
        "setpointStep",
        "heat",
        "cool"
      ],
      "additionalProperties": false,
      "properties": {
        "modes": {
          "type": "array",
          "items": {
            "enum": [
              "heat",
              "cool",
              "auto",
              "off"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "minGap": {
          "type": "number",
          "minimum": 0
        },
        "setpointStep": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "heat": {
          "type": "object",
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "cool": {
          "type": "object",
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        }
      }
    },
    "seed": {
      "type": "object",
      "required": [
        "heat",
        "cool"
      ],
      "additionalProperties": false,
      "properties": {
        "heat": {
          "type": "number"
        },
        "cool": {
          "type": "number"
        }
      }
    },
    "setback": {
      "type": "object",
      "required": [
        "heat",
        "cool"
      ],
      "additionalProperties": false,
      "properties": {
        "heat": {
          "type": "number"
        },
        "cool": {
          "type": "number"
        }
      }
    },
    "protect": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "params": {
      "type": "object",
      "description": "Optional overrides of spec \u00a73.4 parameters.",
      "additionalProperties": {
        "type": "number"
      }
    }
  }
}
