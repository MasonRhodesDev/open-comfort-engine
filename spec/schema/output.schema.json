{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MasonRhodesDev/open-comfort-engine/spec/schema/output.schema.json",
  "title": "Output (spec \u00a77.8)",
  "type": "object",
  "required": [
    "heat",
    "cool",
    "mode",
    "state",
    "band",
    "released",
    "push",
    "reasons",
    "confidence",
    "deltaFromAmbient",
    "thermal",
    "curve",
    "protect"
  ],
  "properties": {
    "heat": {
      "type": "number"
    },
    "cool": {
      "type": "number"
    },
    "mode": {
      "enum": [
        "heat",
        "cool",
        "auto",
        "off"
      ]
    },
    "state": {
      "enum": [
        "SEEDED",
        "LEARNING",
        "CONVERGED",
        "FROZEN"
      ]
    },
    "band": {
      "type": "object",
      "required": [
        "heat",
        "cool"
      ],
      "additionalProperties": false,
      "properties": {
        "heat": {
          "type": "number"
        },
        "cool": {
          "type": "number"
        }
      }
    },
    "released": {
      "type": "object",
      "required": [
        "heat",
        "cool"
      ],
      "additionalProperties": false,
      "properties": {
        "heat": {
          "type": "boolean"
        },
        "cool": {
          "type": "boolean"
        }
      }
    },
    "push": {
      "type": "object",
      "required": [
        "heat",
        "cool"
      ],
      "additionalProperties": false,
      "properties": {
        "heat": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        },
        "cool": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        }
      }
    },
    "reasons": {
      "type": "array",
      "items": {
        "enum": [
          "seed",
          "learned",
          "frozen",
          "conflict",
          "push",
          "released",
          "protect",
          "limit",
          "gap"
        ]
      }
    },
    "confidence": {
      "type": "object",
      "required": [
        "heat",
        "cool"
      ],
      "additionalProperties": false,
      "properties": {
        "heat": {
          "type": "number"
        },
        "cool": {
          "type": "number"
        }
      }
    },
    "deltaFromAmbient": {
      "type": "object",
      "required": [
        "heat",
        "cool"
      ],
      "additionalProperties": false,
      "properties": {
        "heat": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        },
        "cool": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        }
      }
    },
    "thermal": {
      "type": "object",
      "required": [
        "envelope",
        "heat",
        "cool"
      ],
      "properties": {
        "envelope": {
          "type": "number"
        },
        "heat": {
          "type": "number"
        },
        "cool": {
          "type": "number"
        }
      }
    },
    "curve": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "out",
          "heat",
          "cool",
          "heatSigma",
          "coolSigma",
          "thermal"
        ],
        "properties": {
          "out": {
            "type": "number"
          },
          "heat": {
            "type": "number"
          },
          "cool": {
            "type": "number"
          },
          "heatSigma": {
            "type": "number"
          },
          "coolSigma": {
            "type": "number"
          },
          "thermal": {
            "type": "object",
            "required": [
              "envelope",
              "heat",
              "cool"
            ],
            "properties": {
              "envelope": {
                "type": "number"
              },
              "heat": {
                "type": "number"
              },
              "cool": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "protect": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "max",
            "min"
          ]
        }
      ]
    }
  }
}
