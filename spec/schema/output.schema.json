{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MasonRhodesDev/open-comfort-engine/spec/schema/output.schema.json",
  "title": "Engine output (spec \u00a77.10)",
  "type": "object",
  "required": [
    "heat",
    "cool",
    "mode",
    "state",
    "block",
    "blockEnd",
    "band",
    "released",
    "risk",
    "nudge",
    "reasons",
    "confidence",
    "protect"
  ],
  "properties": {
    "heat": {
      "type": "number"
    },
    "cool": {
      "type": "number"
    },
    "mode": {
      "enum": [
        "heat",
        "cool",
        "auto",
        "off"
      ]
    },
    "state": {
      "enum": [
        "SEEDED",
        "LEARNING",
        "CONVERGED",
        "FROZEN",
        "VACANT"
      ]
    },
    "block": {
      "type": "string"
    },
    "reasons": {
      "type": "array",
      "items": {
        "enum": [
          "seed",
          "learned",
          "conflict",
          "nudge",
          "risk",
          "vacant",
          "released",
          "precondition",
          "frozen",
          "sleep",
          "protect",
          "limit",
          "gap"
        ]
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nudge": {
      "type": "object",
      "required": [
        "heat",
        "cool"
      ],
      "additionalProperties": false,
      "properties": {
        "heat": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        },
        "cool": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        }
      }
    },
    "protect": {
      "enum": [
        "max",
        "min",
        null
      ]
    },
    "blockEnd": {
      "type": "string",
      "description": "RFC 3339 start of the next block",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt ]\\d{2}:\\d{2}(:\\d{2}(\\.\\d+)?)?([Zz]|[+-]\\d{2}:\\d{2})$"
    },
    "band": {
      "type": "object",
      "required": [
        "heat",
        "cool"
      ],
      "additionalProperties": false,
      "properties": {
        "heat": {
          "type": "number"
        },
        "cool": {
          "type": "number"
        }
      }
    },
    "released": {
      "type": "object",
      "required": [
        "heat",
        "cool"
      ],
      "additionalProperties": false,
      "properties": {
        "heat": {
          "type": "boolean"
        },
        "cool": {
          "type": "boolean"
        }
      }
    },
    "risk": {
      "type": "object",
      "required": [
        "heat",
        "cool"
      ],
      "additionalProperties": false,
      "properties": {
        "heat": {
          "type": "number"
        },
        "cool": {
          "type": "number"
        }
      }
    }
  },
  "additionalProperties": false
}
