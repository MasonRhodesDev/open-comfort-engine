{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MasonRhodesDev/open-comfort-engine/spec/schema/snapshot.schema.json",
  "title": "Snapshot (spec \u00a79)",
  "type": "object",
  "required": [
    "snapshotVersion",
    "zone",
    "seedKey",
    "curve",
    "voters",
    "reading",
    "weather",
    "quiet",
    "push",
    "complaintAt",
    "released",
    "releasedAt",
    "frozen",
    "protecting",
    "thermal",
    "lastOutput",
    "lastEventAt",
    "lastSnapshotAt"
  ],
  "properties": {
    "snapshotVersion": {
      "const": 3
    },
    "zone": {
      "type": "string"
    },
    "seedKey": {
      "type": "string"
    },
    "curve": {
      "type": "object",
      "required": [
        "heat",
        "cool"
      ],
      "additionalProperties": false,
      "properties": {
        "heat": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "w",
              "n"
            ],
            "properties": {
              "w": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "n": {
                "type": "number"
              }
            }
          }
        },
        "cool": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "w",
              "n"
            ],
            "properties": {
              "w": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "n": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "voters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "step",
          "lastVote"
        ],
        "properties": {
          "step": {
            "type": "number"
          },
          "lastVote": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "at",
                  "dir",
                  "tin"
                ],
                "properties": {
                  "at": {
                    "type": "number"
                  },
                  "dir": {
                    "enum": [
                      "hot",
                      "cold"
                    ]
                  },
                  "tin": {
                    "type": "number"
                  },
                  "equip": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "enum": [
                          "heat",
                          "cool",
                          "fan",
                          "idle",
                          "off"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "reading": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "tin",
            "at"
          ],
          "properties": {
            "tin": {
              "type": "number"
            },
            "rh": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "equip": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "enum": [
                    "heat",
                    "cool",
                    "fan",
                    "idle",
                    "off"
                  ]
                }
              ]
            },
            "applied": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "heat": {
                      "type": "number"
                    },
                    "cool": {
                      "type": "number"
                    },
                    "mode": {
                      "enum": [
                        "heat",
                        "cool",
                        "auto",
                        "off"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "at": {
              "type": "number"
            }
          }
        }
      ]
    },
    "weather": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "out",
            "at"
          ],
          "properties": {
            "out": {
              "type": "number"
            },
            "high": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "low": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "at": {
              "type": "number"
            }
          }
        }
      ]
    },
    "quiet": {
      "type": "object",
      "required": [
        "lastAt"
      ],
      "properties": {
        "lastAt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        }
      }
    },
    "push": {
      "type": "object",
      "required": [
        "heat",
        "cool"
      ],
      "additionalProperties": false,
      "properties": {
        "heat": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        },
        "cool": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        }
      }
    },
    "complaintAt": {
      "type": "object",
      "required": [
        "heat",
        "cool"
      ],
      "additionalProperties": false,
      "properties": {
        "heat": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        },
        "cool": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        }
      }
    },
    "released": {
      "type": "object",
      "required": [
        "heat",
        "cool"
      ],
      "additionalProperties": false,
      "properties": {
        "heat": {
          "type": "boolean"
        },
        "cool": {
          "type": "boolean"
        }
      }
    },
    "frozen": {
      "type": "boolean"
    },
    "protecting": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "max",
            "min"
          ]
        }
      ]
    },
    "thermal": {
      "type": "object",
      "required": [
        "envelope",
        "heat",
        "cool"
      ],
      "properties": {
        "envelope": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "heat": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "cool": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "lastOutput": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "output.schema.json"
        }
      ]
    },
    "lastEventAt": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "number"
        }
      ]
    },
    "lastSnapshotAt": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "number"
        }
      ]
    },
    "releasedAt": {
      "type": "object",
      "required": [
        "heat",
        "cool"
      ],
      "additionalProperties": false,
      "properties": {
        "heat": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        },
        "cool": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        }
      }
    }
  }
}
