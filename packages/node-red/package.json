{
  "name": "node-red-contrib-open-comfort-engine",
  "version": "0.5.0-rc.4",
  "description": "Node-RED nodes for the Open Comfort Engine: learn comfort from too-hot/too-cold votes and drive any thermostat's heat/cool setpoints, with power-saving drift toward idle.",
  "license": "MIT",
  "keywords": ["node-red", "thermostat", "comfort", "hvac", "home-assistant", "climate"],
  "repository": { "type": "git", "url": "git+https://github.com/MasonRhodesDev/open-comfort-engine.git", "directory": "packages/node-red" },
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "comfort-zone": "nodes/comfort-zone.js",
      "comfort-engine": "nodes/comfort-engine.js"
    }
  },
  "engines": { "node": ">=18" },
  "files": ["nodes", "lib", "examples", "README.md", "LICENSE"],
  "scripts": { "build": "node build.mjs" }
}
