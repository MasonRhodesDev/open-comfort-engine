{
  "name": "open-comfort-engine",
  "version": "0.3.0",
  "description": "Reference implementation of the Open Comfort Engine spec: learns comfort from too-hot/too-cold votes and drifts setpoints toward idle. Pure, zero dependencies, no I/O.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" } },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": { "build": "tsup src/index.ts --format esm,cjs --dts --clean" },
  "keywords": ["thermostat", "comfort", "hvac", "home-automation", "node-red", "home-assistant"]
}
